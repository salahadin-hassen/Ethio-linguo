# Copy to .env (git-ignored) on the machine that runs the relay. Never commit .env.
# Provider: addis (Addis AI, Amharic/Afaan Oromo-native) or anthropic.
TUTOR_PROVIDER=addis
ADDIS_API_KEY=
ANTHROPIC_API_KEY=
# Optional
TUTOR_MODEL=claude-opus-5-5
PORT=8787
ALLOW_ORIGIN=*
# Optional: natural English voice for the Professor (Gemini TTS). Falls back to the phone voice.
GEMINI_API_KEY=
